# =====================================================================
# INFOLAST BACKEND — ENVIRONMENT TEMPLATE
# =====================================================================
# Network: Ethereum Sepolia Testnet ONLY (CHAIN_ID=11155111).
# Copy to .env and fill in real values. Never commit real .env files.
# =====================================================================

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://your-frontend.example.com

# ── Database (PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://USER:PASSWORD@HOST:PORT

# ── Security ─────────────────────────────────────────────────────────
ADMIN_SECRET=change-me
APP_SECRET=change-me

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated exact browser origins.
# Do NOT add a trailing slash: https://app.netlify.app  (not .../ )
# The backend normalizes trailing slashes, but keep it clean anyway.
CORS_ORIGIN=https://your-frontend.netlify.app

# ── Blockchain (Sepolia only) ────────────────────────────────────────
# RPC must be a Sepolia endpoint. The backend verifies eth_chainId
# (expected 0xaa36a7 / 11155111) before indexing.
RPC_URL=https://ethereum-sepolia.example-provider.com/YOUR_KEY
CHAIN_ID=11155111

# Optional: only needed for server-side write operations.
PRIVATE_KEY=

# ── Contracts (deployed on Sepolia) ──────────────────────────────────
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
SALE_ADDRESS=0x0000000000000000000000000000000000000000
AIRDROP_ADDRESS=0x0000000000000000000000000000000000000000
VESTING_ADDRESS=0x0000000000000000000000000000000000000000
PRICE_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# ── Airdrop ──────────────────────────────────────────────────────────
CLAIM_START=0
CLAIM_END=0
# Optional; defaults to the snapshot total
CLAIM_CAP_WEI=

# ── Event sync (Purchase / Vesting indexers) ─────────────────────────
# Contract deployment blocks. Set these for a full-history backfill with an
# archive-capable RPC. If unset, the first run only indexes the provider's
# recent log window and records the skipped range as an explicit gap.
SALE_START_BLOCK=
VESTING_START_BLOCK=

# Max blocks per eth_getLogs call. The indexer halves it automatically when
# the provider answers "block range too large".
SYNC_LOG_BATCH_SIZE=2000

# Blocks behind the head that are still queryable without an archive plan.
# Measured on Chainstack Sepolia free plan: ~111 blocks (100 keeps margin).
SYNC_SAFE_LOOKBACK_BLOCKS=100

SYNC_MAX_RETRIES=4
SYNC_RETRY_BASE_DELAY_MS=1000
SYNC_BATCH_DELAY_MS=250

# ── Rate limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ── Telegram (optional) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── Task verification (optional) ─────────────────────────────────────
TWITTER_BEARER_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ── Feature flags ────────────────────────────────────────────────────
ENABLE_SYBIL=false
ENABLE_PAUSE=false
